# Banco de dados
DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma_de_dados?schema=public"

# Servidor
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
# URL pública deste backend (sem barra no final) — usada só pra montar a
# URL de webhook que registramos automaticamente no Liro CRM ao conectar
# a integração (POST .../webhook/:token, ver liro-crm.service.ts). Deixe
# em branco em dev local (o Liro não teria como alcançar localhost mesmo).
PUBLIC_API_URL=""

# JWT
JWT_ACCESS_SECRET="troque-este-segredo-de-acesso-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-em-producao"
JWT_REFRESH_EXPIRES_IN="7d"

# Chave usada para cifrar (AES-256-GCM) credenciais de integrações de
# terceiros salvas no banco (ex.: chave de API do Liro CRM) — troque em produção.
SECRET_ENCRYPTION_KEY="troque-esta-chave-de-cifragem-em-producao"

# Conector CNPJ (dado público oficial — BrasilAPI, sem necessidade de chave)
CNPJ_PROVIDER_BASE_URL="https://brasilapi.com.br/api/cnpj/v1"

# Conectores de dados pessoais (crédito, CPF, telefone, parentes)
# Nesta versão rodam em modo DEMO (dados simulados). Para produção, contrate
# um provedor licenciado (Serasa Experian, Boa Vista SCPC, Big Data Corp,
# Assertiva, Quod) e preencha as credenciais abaixo — o conector correspondente
# em src/modules/data-intelligence/connectors troca de mock para o provedor real.
DATA_PROVIDERS_MODE="demo"
CREDIT_BUREAU_API_KEY=""
CREDIT_BUREAU_BASE_URL=""
PERSON_DATA_PROVIDER_API_KEY=""
PERSON_DATA_PROVIDER_BASE_URL=""
